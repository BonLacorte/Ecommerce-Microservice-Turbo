# ==========================================
# EXTERNAL API KEYS (Required for Recruiters)
# ==========================================

# 1. Clerk Authentication
# Sign up at https://clerk.com/
# Create a new application and copy the API keys from the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# 2. Stripe Payments
# Sign up at https://stripe.com/
# Get your API keys from the Developers Dashboard.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 3. Cloudinary (Image Hosting)
# Sign up at https://cloudinary.com/
# Get your Cloud Name from the dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...

# ==========================================
# INTERNAL SERVICE URLS
# ==========================================
# These use localhost because all services run in the same container.
# No changes needed here.
NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8003

# ==========================================
# DATABASE & KAFKA (Auto-configured by Docker Compose)
# ==========================================
# You do NOT need to change these. They are overridden
# automatically by docker-compose.yml environment settings.
DATABASE_URL=postgresql://postgres:postgres@ecommerce-postgres:5432/ecommerce_products
MONGO_URL=mongodb://ecommerce-mongodb:27017/ecommerce_orders?directConnection=true
KAFKA_BROKERS=kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092
